{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": false,
    "experimentalDecorators": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@features/*": ["features/*"],
      "@fixtures/*": ["src/fixture/*"],
      "@hooks/*": ["src/supports/*"],
      "@step-def/*": ["src/step-def/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "features/**/*.ts",
    "cucumber.js",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "Reports",
    "screenshots",
    "test-results"
  ]
}
